+/*
+ * Charge limit (charge_control_{start,end}_threshold): stop charging once
+ * the displayed SOC reaches the end threshold and resume when it falls to
+ * the start threshold (or end - 1 when start is 0 or not below end).
+ *
+ * Charging is paused the same way the vendor temperature control does it,
+ * by moving the battery low-temperature threshold (BAT_LTS_TS) so the
+ * charger reports BAT_TMP_ERR; the system keeps running from the charger.
+ * Restoring the threshold makes the charger resume on its own, whereas
+ * clearing and setting CHRG_EN leaves it stuck in CHRG_OFF until replug.
+ */
+static void rk817_bat_charge_limit(struct rk817_battery_device *battery)
+{
+	int soc = (battery->dsoc + 400) / 1000;
+	int end = battery->chrg_end_thr;
+	int resume = battery->chrg_start_thr;
+	bool was_inhibited = battery->chrg_inhibited;
+
+	if (battery->chip_id == RK809_ID || battery->pdata->tc_count)
+		return;
+
+	if (resume <= 0 || resume >= end)
+		resume = end - 1;
+
+	if (end >= 100)
+		battery->chrg_inhibited = false;
+	else if (soc >= end)
+		battery->chrg_inhibited = true;
+	else if (soc <= resume)
+		battery->chrg_inhibited = false;
+
+	if (battery->chrg_inhibited) {
+		int lts = rk817_bat_field_read(battery, BAT_LTS_TS);
+
+		if (lts > 0) {
+			if (!was_inhibited)
+				battery->chrg_lts_saved = lts;
+			rk817_bat_disable_charge(battery);
+		}
+	} else if (was_inhibited) {
+		if (battery->chrg_lts_saved > 0)
+			rk817_bat_field_write(battery, BAT_LTS_TS,
+					      battery->chrg_lts_saved);
+		else
+			rk817_bat_enable_charge(battery);
+	}
+
+	if (battery->chrg_inhibited != was_inhibited)
+		BAT_INFO("charge limit: soc=%d%% start=%d end=%d -> charging %s\n",
+			 soc, battery->chrg_start_thr, end,
+			 battery->chrg_inhibited ? "inhibited" : "allowed");
+}
