+static int rk817_battery_set_property(struct power_supply *psy,
+				      enum power_supply_property psp,
+				      const union power_supply_propval *val)
+{
+	struct rk817_battery_device *battery = power_supply_get_drvdata(psy);
+
+	if (val->intval < 0 || val->intval > 100)
+		return -EINVAL;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		battery->chrg_start_thr = val->intval;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		battery->chrg_end_thr = val->intval;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Apply the new limit now instead of on the next monitor tick. */
+	mod_delayed_work(battery->bat_monitor_wq, &battery->bat_delay_work, 0);
+
+	return 0;
+}
+
+static int rk817_battery_property_is_writeable(struct power_supply *psy,
+					       enum power_supply_property psp)
+{
+	struct rk817_battery_device *battery = power_supply_get_drvdata(psy);
+
+	/* No charger on RK809; the temperature table owns BAT_LTS_TS. */
+	if (battery->chip_id == RK809_ID || battery->pdata->tc_count)
+		return 0;
+
+	return psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD;
+}
