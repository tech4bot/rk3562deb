+	[OCV_VOL_H] = REG_FIELD(0x63, 0, 7),
+	[OCV_VOL_L] = REG_FIELD(0x64, 0, 7),
 	[PWRON_VOL_H] = REG_FIELD(0x6B, 0, 7),
 	[PWRON_VOL_L] = REG_FIELD(0x6C, 0, 7),
 	[PWRON_CUR_H] = REG_FIELD(0x6D, 0, 7),
@@ -888,6 +899,23 @@ static void rk817_bat_set_relax_sample(struct rk817_battery_device *battery)
 	    __func__, pdata->sleep_enter_current, pdata->sleep_exit_current);
 }
 
+/* OCV battery voltage */
+static int rk817_bat_get_ocv_voltage(struct rk817_battery_device *battery)
+{
+	int vol, val = 0, vol_temp;
+
+	val = rk817_bat_field_read(battery, OCV_VOL_H) << 8;
+	val |= rk817_bat_field_read(battery, OCV_VOL_L);
+	vol = battery->voltage_k * val / 1000 + battery->voltage_b;
+	if (battery->chip_id == RK809_ID) {
+		vol_temp = vol * battery->pdata->bat_res_up /
+			   battery->pdata->bat_res_down + vol;
+		vol = vol_temp;
+	}
+
+	return vol;
+}
+
 /* power on battery voltage */
 static int rk817_bat_get_pwron_voltage(struct rk817_battery_device *battery)
 {
@@ -2084,16 +2112,33 @@ static void rk817_bat_init_dsoc_algorithm(struct rk817_battery_device *battery)
 
 static void rk817_bat_first_pwron(struct rk817_battery_device *battery)
 {
-	battery->rsoc =
-		rk817_bat_vol2soc(battery,
-				  battery->pwron_voltage);/* uAH */
+	int ref_vol;
+	int ocv_vol;
+
+	/*
+	 * Prefer the latched OCV register over pwron_voltage when sane.
+	 * pwron_voltage is sampled at the instant of power-on and can be
+	 * pulled down by inrush load, biasing the initial SOC low; OCV is
+	 * sampled by the PMIC during a relax window and is far closer to
+	 * true open-circuit voltage.
+	 */
+	ocv_vol = rk817_bat_get_ocv_voltage(battery);
+	if (ocv_vol >= 3000 && ocv_vol <= 4400)
+		ref_vol = ocv_vol;
+	else
+		ref_vol = battery->pwron_voltage;
+
+	battery->rsoc = rk817_bat_vol2soc(battery, ref_vol);/* uAH */
 	battery->dsoc = battery->rsoc;
 	battery->fcc = battery->pdata->design_capacity;
 	if (battery->fcc < MIN_FCC)
 		battery->fcc = MIN_FCC;
 
-	battery->nac = rk817_bat_vol2cap(battery, battery->pwron_voltage);
+	battery->nac = rk817_bat_vol2cap(battery, ref_vol);
 	battery->fcc = battery->pdata->design_capacity;
+	BAT_INFO("first_pwron: ocv=%dmV pwron=%dmV ref=%dmV rsoc=%d nac=%d\n",
+		 ocv_vol, battery->pwron_voltage, ref_vol,
+		 battery->rsoc, battery->nac);
 
 	rk817_bat_update_qmax(battery, battery->qmax);
 	rk817_bat_save_fcc(battery, battery->fcc);
@@ -2104,6 +2149,8 @@ static void rk817_bat_first_pwron(struct rk817_battery_device *battery)
 static void rk817_bat_not_first_pwron(struct rk817_battery_device *battery)
 {
 	int now_cap, pre_soc, pre_cap;
+	int ocv_vol, ocv_soc, ocv_cap;
+	int ref_vol;
 
 	battery->fcc = rk817_bat_get_fcc(battery);
 	pre_soc = rk817_bat_get_prev_dsoc(battery);
@@ -2128,7 +2175,42 @@ static void rk817_bat_not_first_pwron(struct rk817_battery_device *battery)
 		BAT_INFO("initialized yet..\n");
 	}
 
+	/*
+	 * Always recalibrate dsoc/cap from the PMIC's OCV register or
+	 * power-on voltage at boot.
+	 *
+	 * The RK817 hardware samples open-circuit voltage during low-current
+	 * (relax) periods, so the value latched in OCV_VOL is ideal when present.
+	 * If OCV_VOL is unpopulated / out-of-range (e.g. cold boot where 0x63/0x64
+	 * reads 0), fall back to pwron_voltage (sampled by PMIC ADC at power-on),
+	 * exactly as rk817_bat_first_pwron() does.
+	 * Without this fallback, a cold boot with is_halt=true leaves pre_soc at 0,
+	 * causing the tablet to report 0% capacity and trigger immediate shutdown.
+	 */
+	ocv_vol = rk817_bat_get_ocv_voltage(battery);
+	if (ocv_vol >= 3000 && ocv_vol <= 4400)
+		ref_vol = ocv_vol;
+	else if (battery->pwron_voltage >= 3000 && battery->pwron_voltage <= 4400)
+		ref_vol = battery->pwron_voltage;
+	else
+		ref_vol = 0;
+
+	if (ref_vol >= 3000 && ref_vol <= 4400) {
+		ocv_soc = rk817_bat_vol2soc(battery, ref_vol);
+		ocv_cap = rk817_bat_vol2cap(battery, ref_vol);
+		BAT_INFO("boot OCV calib: ref=%dmV (ocv=%d pwron=%d) pre(dsoc=%d cap=%d) -> new(dsoc=%d cap=%d)\n",
+			 ref_vol, ocv_vol, battery->pwron_voltage, pre_soc, pre_cap, ocv_soc, ocv_cap);
+		pre_soc = ocv_soc;
+		pre_cap = ocv_cap;
+		rk817_bat_init_coulomb_cap(battery, ocv_cap);
+		battery->remain_cap = ocv_cap * 1000;
+	} else {
+		BAT_INFO("boot OCV calib skipped: ocv=%dmV pwron=%dmV out of range\n",
+			 ocv_vol, battery->pwron_voltage);
+	}
+
 	battery->dsoc = pre_soc;
+	battery->rsoc = pre_soc;
 	battery->nac = pre_cap;
 	if (battery->nac < 0)
 		battery->nac = 0;
